{
  "components": {
    "schemas": {
      "Batch": {
        "additionalProperties": false,
        "properties": {
          "events": {
            "items": {
              "$ref": "#/components/schemas/Event"
            },
            "maxItems": 100,
            "minItems": 1,
            "title": "Events",
            "type": "array"
          }
        },
        "required": [
          "events"
        ],
        "title": "Batch",
        "type": "object"
      },
      "CaseCommand": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "enum": [
              "assign",
              "triage",
              "investigate",
              "request_information",
              "resume",
              "submit",
              "return",
              "close",
              "comment",
              "evidence"
            ],
            "title": "Action",
            "type": "string"
          },
          "assignee": {
            "anyOf": [
              {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Assignee"
          },
          "outcome": {
            "anyOf": [
              {
                "enum": [
                  "CONFIRMED",
                  "FALSE_POSITIVE",
                  "INCONCLUSIVE"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Outcome"
          },
          "reason": {
            "maxLength": 2000,
            "minLength": 4,
            "title": "Reason",
            "type": "string"
          },
          "revision": {
            "minimum": 1.0,
            "title": "Revision",
            "type": "integer"
          }
        },
        "required": [
          "revision",
          "action",
          "reason"
        ],
        "title": "CaseCommand",
        "type": "object"
      },
      "Csv": {
        "additionalProperties": false,
        "properties": {
          "text": {
            "maxLength": 100000,
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "Csv",
        "type": "object"
      },
      "Event": {
        "additionalProperties": false,
        "properties": {
          "account": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
            "title": "Account",
            "type": "string"
          },
          "amount": {
            "exclusiveMinimum": 0.0,
            "maximum": 100000000000.0,
            "title": "Amount",
            "type": "integer"
          },
          "category": {
            "enum": [
              "GROCERY",
              "SERVICES",
              "TRAVEL",
              "ELECTRONICS",
              "TRANSFER"
            ],
            "title": "Category",
            "type": "string"
          },
          "channel": {
            "enum": [
              "CARD",
              "WEB",
              "MOBILE"
            ],
            "title": "Channel",
            "type": "string"
          },
          "currency": {
            "const": "RUB",
            "default": "RUB",
            "title": "Currency",
            "type": "string"
          },
          "external_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
            "title": "External Id",
            "type": "string"
          },
          "occurred_at": {
            "format": "date-time",
            "title": "Occurred At",
            "type": "string"
          },
          "recipient": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
            "title": "Recipient",
            "type": "string"
          },
          "source": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
            "title": "Source",
            "type": "string"
          }
        },
        "required": [
          "source",
          "external_id",
          "account",
          "amount",
          "category",
          "channel",
          "recipient",
          "occurred_at"
        ],
        "title": "Event",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Login": {
        "additionalProperties": false,
        "properties": {
          "login": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
            "title": "Login",
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "login",
          "password"
        ],
        "title": "Login",
        "type": "object"
      },
      "RuleDraft": {
        "additionalProperties": false,
        "properties": {
          "parameters": {
            "additionalProperties": {
              "type": "integer"
            },
            "title": "Parameters",
            "type": "object"
          },
          "reason": {
            "maxLength": 2000,
            "minLength": 4,
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "parameters",
          "reason"
        ],
        "title": "RuleDraft",
        "type": "object"
      },
      "RuleSwitch": {
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "title": "Enabled",
            "type": "boolean"
          },
          "reason": {
            "maxLength": 2000,
            "minLength": 4,
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "enabled",
          "reason"
        ],
        "title": "RuleSwitch",
        "type": "object"
      },
      "Scenario": {
        "enum": [
          "normal",
          "large",
          "burst",
          "outlier",
          "recipient",
          "combination",
          "duplicate",
          "invalid",
          "late",
          "version",
          "reassessment",
          "multiple_alerts",
          "grouping",
          "assignment",
          "escalation",
          "false_positive",
          "confirmed",
          "concurrency",
          "close_replay",
          "compare",
          "sla",
          "recovery"
        ],
        "title": "Scenario",
        "type": "string"
      },
      "User": {
        "additionalProperties": false,
        "properties": {
          "login": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
            "title": "Login",
            "type": "string"
          },
          "name": {
            "maxLength": 2000,
            "minLength": 4,
            "title": "Name",
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          },
          "role": {
            "enum": [
              "FRAUD_ANALYST",
              "SENIOR_ANALYST",
              "FRAUD_MANAGER",
              "RULES_ADMIN",
              "ADMIN"
            ],
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "login",
          "password",
          "name",
          "role"
        ],
        "title": "User",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
